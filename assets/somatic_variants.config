params {
    // Every projectify location below comes from the project source_me.sh.
    // run_somatic_variants.sh checks these (bar COHORT_METADATA_FILE) are exported before nextflow is launched -
    // an unset variable is not an error to the config parser, it silently becomes
    // the literal '[:]', so the guard in the wrapper is what catches it.
    cohort_prefix = "${STUDY}_${PROJECT}_${COHORT}"
    caveman_vcfs = "${ANALYSIS_DIR}/caveman_files/**.smartphase.vep.vcf.gz"
    caveman_outdir = "${ANALYSIS_DIR}/caveman_files"
    pindel_vcfs = "${ANALYSIS_DIR}/pindel_files/**.pindel.vep.vcf.gz"
    pindel_outdir = "${ANALYSIS_DIR}/pindel_files"
    outdir = "${ANALYSIS_DIR}/variants_combined"
    run_signatures = true
    sigprofiler_outdir = "${ANALYSIS_DIR}/sigprofiler"
    dndscv_outdir = "${ANALYSIS_DIR}/dndscv"
    release_version = "version1"
    // Optional, so read with getenv: an unset variable in a "${...}" string becomes the
    // literal '[:]' rather than null, and the wrapper does not require this one.
    metadata_manifest = System.getenv('COHORT_METADATA_FILE') ?: null

    // Define subcohorts - each key is the subcohort name, each value the sample_list of
    // tumours (matched and unmatched) for that subcohort.
    // The sample lists are generated and versioned by dermanager, so it owns their paths.
    subcohorts = [
        "all": [
            sample_list: "${DNA_PAIR_LIST_ANALYSED_ALL}"
        ],
        "onePerPatient": [
            sample_list: "${DNA_PAIR_LIST_ONE_TUMOUR_PER_PATIENT_ALL}"
        ],
        "independent": [
            sample_list: "${DNA_PAIR_LIST_INDEPENDENT_TUMOURS_ALL}"
        ],
        // Empty for most cohorts; a subcohort with no tumours produces no outputs.
        "related": [
            sample_list: "${DNA_PAIR_LIST_RELATED_TUMOURS_ALL}"
        ]
    ]

    // Cohort-independent, pipeline-owned: not a source_me.sh concern.
    publish_dir_mode = "copy"
    exome_size = 48.225157
    baitset = "/lustre/scratch127/casm/projects/dermatlas/resources/baitset/GRCh38_WES5_canonical_pad100.merged.bed"
    dbsnp_variants = "/lustre/scratch127/casm/projects/dermatlas/resources/dbsnp/dbSNP155_common.tsv.gz{,.tbi}"
    dbsnp_header = "/lustre/scratch127/casm/projects/dermatlas/resources/dbsnp/addheader.txt"
    genome_build = "GRCh38"
    filtering_column = "gnomAD_AF"
    filter_option = "filter2"
    alternative_transcripts = "/lustre/scratch127/casm/projects/dermatlas/resources/ensembl/dermatlas_noncanonical_transcripts_ens103.tsv"

    // Run reporting needs no params here: it is gated by the DERMATLAS_WEBSITE_LOGGING /
    // DERMATLAS_SLACK_NOTIFICATIONS env vars exported by run_somatic_variants.sh, and the
    // pipeline's onComplete handler reads the payload values (COHORT_SLUG,
    // SAMPLE_LIST_VERSION_FILE, SELF_DESCRIBING_API, SLACK_WEBHOOK_URL) straight from
    // the environment.
}
