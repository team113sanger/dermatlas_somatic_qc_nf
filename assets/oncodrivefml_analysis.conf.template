[genome]
build = hg38

[signature]
method = complement

[score]
file = __CADD_TABIX__
format = tabix
chr = 0
chr_prefix =
pos = 1
ref = 2
alt = 3
score = 5

[statistic]
method = amean
discard_mnp = False
sampling = 100000
sampling_chunk = 1000
sampling_min_obs = 10

    [[indels]]
    include = TRUE
    method = max
    max_consecutive = 7

[settings]
cores = __CORES__
